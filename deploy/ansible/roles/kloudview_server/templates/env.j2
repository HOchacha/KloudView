# {{ ansible_managed }}
COMPOSE_PROJECT_NAME={{ kloudview_server_compose_project }}
KLOUDVIEW_VERSION={{ kloudview_server_version }}

KLOUDVIEW_ENROLLMENT_TOKEN={{ kloudview_enrollment_token }}
KLOUDVIEW_AGENT_CREDENTIAL_KEY={{ kloudview_agent_credential_key }}
KLOUDVIEW_POSTGRES_PASSWORD={{ kloudview_postgres_password }}
# Seeded on first start only; changing it here later does not change the account.
KLOUDVIEW_ADMIN_PASSWORD={{ kloudview_admin_password }}

KLOUDVIEW_PUBLIC_URL={{ kloudview_public_url }}
KLOUDVIEW_HTTP_PORT={{ kloudview_server_http_port }}

KLOUDVIEW_AGENT_TARGET_VERSION={{ kloudview_server_agent_target_version }}
KLOUDVIEW_AGENT_CANARY={{ kloudview_server_agent_canary }}
KLOUDVIEW_AGENT_CANARY_SOAK={{ kloudview_server_agent_canary_soak }}
